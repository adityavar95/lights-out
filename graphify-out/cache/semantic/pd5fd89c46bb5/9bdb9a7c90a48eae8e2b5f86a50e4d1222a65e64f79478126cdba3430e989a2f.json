{"nodes": [{"id": "trail_learnings_2026_10_26_f1_tv_archive_videos_play_as_aditya_archive_hls_playback", "label": "Archive F1 TV videos play as HLS", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-f1-tv-archive-videos-play-as-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "CONTENT/PLAY for archive content returns streamType HLS (H.264, 1080p max, 2010 race 576p25), so the 4K override header is ignored and the frontend must handle the t.hls path."}, {"id": "trail_learnings_2026_10_26_f1_tv_archive_videos_play_as_aditya_catalogue_sweep_403", "label": "Full catalogue sweep gets IP blocked by F1 TV", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-f1-tv-archive-videos-play-as-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Hundreds of catalogue searches in minutes got every request 403'd by F1 TV and 429'd by Jolpica; probe a handful of races, not every race 1981-2026."}, {"id": "trail_learnings_2026_10_26_f1_tv_archive_videos_play_as_aditya_token_per_tab", "label": "F1 TV token is per browser tab", "file_type": "concept", "source_file": ".trail/learnings/2026-10-26-f1-tv-archive-videos-play-as-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "The token lives in sessionStorage, so the bookmarklet connects only the tab it was clicked in."}, {"id": "src_static_multiviewer", "label": "src/static/multiviewer.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-f1-tv-archive-videos-play-as-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_f1tv", "label": "src/f1tv.py", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-f1-tv-archive-videos-play-as-adit