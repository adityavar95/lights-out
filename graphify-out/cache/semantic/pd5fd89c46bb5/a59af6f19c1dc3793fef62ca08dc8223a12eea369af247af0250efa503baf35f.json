{"nodes": [{"id": "trail_learnings_2026_10_29_syntax_check_src_static_modules_with_aditya_node_module_check", "label": "Syntax-check frontend modules as ES modules", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-29-syntax-check-src-static-modules-with-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "node --check passed a file the browser rejected; src/static has no package.json so Node treats files as CommonJS. Use node --input-type=module --check on stdin."}, {"id": "trail_learnings_2026_10_29_syntax_check_src_static_modules_with_aditya_python_heredoc_escape", "label": "Writing JS via Python heredoc breaks escapes", "file_type": "concept", "source_file": ".trail/learnings/2026-10-29-syntax-check-src-static-modules-with-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "An escaped single quote inside a Python string does not come out as an escaped quote in JS; use double quotes in the JS instead."}], "edges": [{"source": "trail_learnings_2026_10_29_syntax_check_src_static_modules_with_aditya_node_module_check", "target": "src_static_replay", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-29-syntax-check-src-static-modules-with-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_29_syntax_check_src_static_modules_with_aditya_python_heredoc_escape", "target": "trail_learnings_2026_10_29_syntax_check_src_static_modules_with_aditya_node_module_check", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-29-syntax-check-src-static-modules-with-aditya.md", "source_location": null, "weight": 1.0}], "hyperedges": []}