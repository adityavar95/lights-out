{"nodes": [{"id": "claude_f1_claude_md", "label": "F1 app CLAUDE.md", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_no_build_step", "label": "No-build vanilla JS ES modules served at /static", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Frontend avoids a build step; three.js via import map in index.html"}, {"id": "claude_table_endpoint_format", "label": "Table endpoints return {columns,data,total}", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uniform shape lets the data explorer render any table generically; capped at MAX_ROWS"}, {"id": "claude_raw_json", "label": "raw_json fast response path", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Big payloads skip FastAPI jsonable_encoder because it is slow"}, {"id": "claude_jolpica", "label": "Jolpica API (Ergast successor)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rate limit ~500 req/h, so season race list is cached"}, {"id": "claude_settled_cache", "label": "SETTLED disk-cached Jolpica client", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Past seasons and races >3 days old cannot change, so use basef1 client with sqlite disk cache (.cache/jolpica.sqlite); recent data uses livef1 5 min in-memory cache"}, {"id": "claude_openf1", "label": "OpenF1 API", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free tier ~30 req/min; a GPS replay costs ~30 requests; answers 401 while any session is live"}, {"id": "claude_openf1_locked", "label": "OpenF1Locked live fallback", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "While a session is live OpenF1 returns 401, so season meetings/sessions are kept in .cache/openf1 and /api/season falls back to livef1; /api/replay answers 409 LIVE_NOW"}, {"id": "claude_multiviewer", "label": "MultiViewer circuit data", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Track outlines share coordinate system with OpenF1 car positions; MV_KEYS maps Jolpica circuitId to MultiViewer key; supplies pitLoss and minisectors"}, {"id": "claude_track_outline_sources", "label": "Track outline source fallback chain", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MultiViewer first, then OpenF1 lap (Madring, Sepang, no corner numbers), then nearest GeoJSON circuit (local metres, unknown start/direction)"}, {"id": "claude_clean_loop", "label": "_clean_loop outline cleaning", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dropping sub-metre duplicates and MultiViewer's start-overlap tail removed false hairpins"}, {"id": "claude_replay_gps_mode", "label": "Replay gps mode (2023+)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Location resampled to 0.5 s grid; event feeds time-sorted for browser binary search"}, {"id": "claude_replay_laps_mode", "label": "Replay laps mode (1996+)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses Jolpica cumulative lap times where no GPS exists"}, {"id": "claude_replay_cache", "label": "Replay disk cache .cache/replay", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finished sessions cached per session_key; must delete after payload format change; atomic tmp+replace save(); REPLAY_LOCKS make concurrent requests wait"}, {"id": "claude_warm_latest_replay", "label": "warm_latest_replay start-up thread", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Builds latest race replay in background so default race avoids ~40 s wait on first play"}, {"id": "claude_elevation", "label": "Elevation from OpenF1 location z", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "z in decimetres on a fast race lap at the circuit (2023+), cached per circuitId; feeds grade and vertical load in physics"}, {"id": "claude_geo_outline", "label": "Real circuit outline /api/geo", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GeoJSON outline in local metres used to georeference satellite ground"}, {"id": "claude_f1tv", "label": "F1 TV catalogue and playback", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "MultiViewer-style viewer using public catalogue search plus subscription token as ascendontoken for signed DASH manifest; replays have no DRM, live streams are Widevine (untested)"}, {"id": "claude_shaka_player", "label": "shaka-player", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plays F1 TV DASH under custom control bar; loaded from jsDelivr and pre-loaded when F1 TV list opens"}, {"id": "claude_f1tv_startup_tuning", "label": "F1 TV start-up tuning", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ignoreMinBufferTime cut first-frame delay from 12 s to 2 s; load with startTime so joining tile skips session start; bandwidth estimate from navigator.connection"}, {"id": "claude_f1tv_4k", "label": "F1 TV 4K mode", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "x-f1-override-video-stream HDR_UHD_DASH header adds 2160p50 HEVC Main10; preferredVideoCodecs hvc1.2 and minHeight 2160 needed because shaka keeps one video set; disabled where mediaCapabilities cannot decode"}, {"id": "claude_f1tv_clock_sync", "label": "F1 TV replay clock offset", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replays are static DASH from 0 s with no prft/PDT, so video 0 s is placed at scheduled start minus LEAD (308 s measured on 2026 US GP) plus per-video localStorage offset set by nudges or Lights out"}, {"id": "claude_f1tv_telemetry_overlay", "label": "F1 TV see-through telemetry overlay", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "session_telemetry covers whole session, cached under its own _tv tag because telemetry() cache ignores start"}, {"id": "claude_signalr_feed", "label": "F1 SignalR Core live timing feed", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Free /signalrcore feed without login; one background connection opened on first /api/live request and closed after IDLE s; updates deep-merged"}, {"id": "claude_f1_token_auth", "label": "F1 TV subscription token auth", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Position.z and CarData.z silently omitted without token; sign in like FastF1 via PingOne OAuth+PKCE; credentials from env or gitignored .cache, never in source; 10 min back-off after failure"}, {"id": "claude_live_gps_fallback", "label": "Live GPS with mini-sector fallback", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "hasGps falls back to mini-sector placement once samples stop for 5 s; liveGps/gpsAt interpolate ~1.8 s behind the feed"}, {"id": "claude_replay_render_loop", "label": "Replay render loop", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "render passes positions now and 0.5 s ahead (for heading) to scene3d; DOM tower throttled, HUD gauges every frame"}, {"id": "claude_simulation_session", "label": "Simulation session (physics race)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pure-JS race sim with grid from Jolpica results; opened from circuit selector or Race this era"}, {"id": "claude_envelope_solver", "label": "envelope backward-pass speed solver", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Friction circle, drag, grade, banking; used for AI braking and the ribbon"}, {"id": "claude_aero_model", "label": "Aero and ground-effect model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Downforce on normal load, heave/porpoising, plank strikes, tow/dirty air, DRS; circuit aero trim from longest straight"}, {"id": "claude_tyre_model", "label": "Tyre model: 5 compounds", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Grip/heat/wear on wet asphalt, aquaplaning speed, thermal windows, wear cliff"}, {"id": "claude_racecraft_ai", "label": "AI racecraft", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lanes with tow, attack, one-move defence, leave-the-space; in-lane blocker, contacts and wing damage"}, {"id": "claude_player_driving", "label": "Player driving model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Speed-sensitive steering with self-centring, TC/ABS/braking assist, auto/manual gearbox with limiter"}, {"id": "claude_pit_lane_trace", "label": "pitTrace real pit lane", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": 