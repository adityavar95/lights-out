ributor": null, "rationale": "matrixWorldAutoUpdate off; redraw only while something moves, else 4 times a second, to save GPU"}, {"id": "claude_post_pipeline", "label": "Post-processing pipeline", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Motion-vector pass with overrideMaterial skipping layer 1, MSAA half-float composer, motion blur, bloom, OutputPass tone mapping"}, {"id": "claude_polyhaven_hdri", "label": "Poly Haven HDRI environment", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Background and PMREM environment; sun aimed at brightest texel; Preetham Sky fallback"}, {"id": "claude_rb22_model", "label": "RB22 glb car model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CC BY 4.0 (models/CREDITS.md); 2026+ cars are THREE.LOD with RB22 up close and procedural car beyond 50 m"}, {"id": "claude_derived_telemetry", "label": "Derived HUD telemetry", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "g-forces, tyre temps/wear, ERS, DRS zones always modelled from the car's path as pure functions; engine(year) gives per-era power unit"}, {"id": "claude_trace_telemetry", "label": "Telemetry trace", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sim channels resampled onto 500 lap-distance buckets per physics substep via R.onStep; current/previous/fastest lap, delta-t, engineer insights, CSV/JSON export"}, {"id": "claude_audio_synthesis", "label": "Procedural engine audio", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Web Audio engine-order PeriodicWave at rpm/120 with jitter, resonances, turbo/MGU-K, HRTF panners and manual Doppler; needs a click to start"}, {"id": "claude_whatif_model", "label": "Strategy Lab what-if model", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replays a real race from Jolpica lap times with one driver's stops moved; per-stint a+b*age tyre fit, SC squeeze, pass needs pace edge PASS; real plan reproduces real race exactly; optimise brute-forces 1-3 stops"}, {"id": "claude_race_control", "label": "Race control state machine", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GREEN/VSC/SC with DRS interlocks; messages are the sim's race-control feed"}, {"id": "claude_test_suite", "label": "Test suite (plain asserts, node scripts)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Python tests without pytest plus node tests per subsystem: live, telemetry, sim, player, circuits, trace, whatif, multiviewer"}, {"id": "claude_dead_ends", "label": "Known dead ends (Oct 2026)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Old livetiming /static and /signalr return 401 so livef1 session data unavailable; livef1 f1.com results scrape 404s; livef1.get_season(2010) raises"}, {"id": "claude_livef1", "label": "livef1 library 1.2.11", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url