{"nodes": [{"id": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_career_positions_by_season", "label": "Driver career positions from per-season standings", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "Jolpica answers 400 without season_year on driverstandings, so career championship positions are built from each season's driverstandings table; results endpoint works without a season. Cold career (23 seasons) takes about 10 s, then cached."}, {"id": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_wikipedia_pilicense_any", "label": "Wikipedia portraits use pilicense any", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "Default free-images-only pageimages left out about half the 1950s grid, including champion Mike Hawthorn; pilicense any restores them."}, {"id": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_eager_stream_rows", "label": "Stream rows load eagerly, three at a time", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "IntersectionObserver never fires while the browser is not painting (hidden preview pane), so rows sat on skeletons; every row is loaded three at a time instead."}, {"id": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_reserve_driver_initials", "label": "Reserve drivers keep initials", "file_type": "concept", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-29", "author": "ADITYA", "contributor": null, "rationale": "FP1-only reserve drivers have no Wikipedia url in Jolpica, and guessing the article from the name could show the wrong person, so they keep initials."}, {"id": "src_jolpica", "label": "src/jolpica.py", "file_type": "code", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_static_drivers", "label": "src/static/drivers.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_static_stream", "label": "src/static/stream.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_career_positions_by_season", "target": "src_jolpica", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_29_jolpica_refuses_driver_standings_without_a_aditya_wikipedia_pilicense_any", "target": "src_static_drivers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-29-jolpica-refuses-driver-standings-without-a-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_29_jolpi