{"nodes": [{"id": "claude", "label": "CLAUDE.md (F1 project guide)", "file_type": "document", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_table_endpoint_contract", "label": "Table endpoint contract {columns, data, total} capped at MAX_ROWS", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One uniform shape lets the data explorer render every table endpoint generically; capped at MAX_ROWS (5,000) to bound payload size."}, {"id": "claude_jolpica_paging", "label": "JOLPICA kind map + jolpica_fetch paging past 100-row limit", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "JOLPICA maps each kind to a query method and the JSON path to one row; jolpica_fetch pages because Jolpica returns at most 100 rows per request."}, {"id": "claude_multiviewer_outlines", "label": "MultiViewer track outlines (MV_KEYS circuitId mapping)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Preferred because MultiViewer uses the same coordinate system as OpenF1 car positions, so GPS traces overlay the outline directly."}, {"id": "claude_geojson_fallback", "label": "Nearest GeoJSON circuit fallback by lat/long", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Covers circuits MultiViewer lacks; local metres, but start line and direction unknown."}, {"id": "claude_track_widths", "label": "WIDTHS approximate track width per circuit", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_gps_replay_mode", "label": "GPS replay mode (2023+, OpenF1, 0.5 s grid)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Location resampled to a 0.5 s grid and event feeds sorted by time so the browser can binary search them."}, {"id": "claude_laps_replay_mode", "label": "Lap-timing replay mode (1996+, Jolpica cumulative lap times)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fallback before GPS data exists; positions exact only at the lap line, cars move at average lap pace in between."}, {"id": "claude_replay_cache", "label": "Replay cache .cache/replay/{session_key}.json", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Finished sessions are cached because a GPS replay costs ~30 OpenF1 requests; must be deleted after changing the payload format."}, {"id": "claude_openf1_rate_limit", "label": "OpenF1 free tier ~30 req/min", "file_type": "rationale", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constraint that drives replay caching; one GPS replay costs about 30 requests."}, {"id": "claude_live_background_connection", "label": "Single idle-closing live SignalR connection with deep merge", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opened by first /api/live request, closed after IDLE seconds without one; updates deep-merged where dict updates to lists address items by index. Position.z/CarData.z skipped because they need F1 TV."}, {"id": "claude_true_scale_scene", "label": "True-scale scene (map.mps metres per scene unit, SIZE)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Map coords become the ground plane scaled to SIZE; map.mps keeps track and cars at true scale in every camera view."}, {"id": "claude_sky_and_follow_shadow", "label": "Preetham Sky environment + camera-following sun shadow (followShadow)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sky doubles as the PMREM environment; shadow map follows camera target so a single shadow map stays sharp near the action."}, {"id": "claude_camera_modes", "label": "Camera modes overview / chase / onboard", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "claude_steering_from_heading", "label": "Steering angle from heading change per metre", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "render passes positions now and 0.5 s ahead so updateCars can derive heading and the focused car's steering angle."}, {"id": "claude_era_regulation_cars", "label": "Procedural cars from per-era regulation dimensions (CHANGES)", "file_type": "concept", "source_file": "CLAUDE.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One merged template per era shared by all cars keeps draw cost low; per-car paint, helmet and tyre stripe applied on top."}, {"id": "claude_minisector_placement", "label": "Live car placement from completed mini-sectors eased at lap pace", "file_type": "concep