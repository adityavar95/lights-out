{"nodes": [{"id": "trail_learnings_2026_10_26_lap_timing_replay_lanes_pass_side_aditya_pass_side_fixed_per_pair", "label": "Pass side fixed per car pair", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-lap-timing-replay-lanes-pass-side-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Side is a hash of the pair's ids so it never flips mid-pass; the passer is the car with higher steady median lap pace, so the faster car moves aside about 3.2 m."}, {"id": "trail_learnings_2026_10_26_lap_timing_replay_lanes_pass_side_aditya_push_apart_step", "label": "Push-apart pass for lane chains", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-lap-timing-replay-lanes-pass-side-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Without a final push-apart pass, chains (A passes B while B passes C) put two cars on the same side, as seen with bottas and leclerc on lap 1."}, {"id": "trail_learnings_2026_10_26_lap_timing_replay_lanes_pass_side_aditya_corner_curvature_side_rejected", "label": "Side from next-corner curvature ruled out", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-lap-timing-replay-lanes-pass-side-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Side from the inside of the next corner flips mid-pass on slow closing speeds, putting the passer across the other car (Abu Dhabi 2021)."}, {"id": "trail_learnings_2026_10_26_lap_timing_replay_lanes_pass_side_aditya_lap_speed_passer_rejected", "label": "Passer from current lap speed ruled out", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-lap-timing-replay-lanes-pass-side-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "A