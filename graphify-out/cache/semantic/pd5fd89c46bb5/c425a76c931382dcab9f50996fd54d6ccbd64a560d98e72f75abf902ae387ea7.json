{"nodes": [{"id": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_in_code_timers", "label": "In-code timers instead of PerformanceObserver", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "performance.now() probes and a setInterval gap detector measured main-thread cost; PerformanceObserver longtask returned nothing in the desktop browser pane. Race switch dropped from 1.3-1.9 s blocked to 0.1-0.2 s."}, {"id": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_gpu_imagebitmap_dies", "label": "GPU ImageBitmap invalid after worker terminates", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "transferToImageBitmap from a GPU OffscreenCanvas in a worker is invalid after terminate (black ground, invalid mailbox GL warnings); satellite uses a CPU 2d canvas with willReadFrequently."}, {"id": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_hidden_pane_visibility", "label": "Hidden desktop pane throttles timers and rAF", "file_type": "concept", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "When the user hides the pane, visibilityState becomes hidden: timers throttle to 1 s and rAF stops, so gap measurements are meaningless unless visibilityState is checked."}, {"id": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_reload_after_edit", "label": "Reload pane after editing modules", "file_type": "concept", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "A dynamic import() in the console returns the page's already-loaded old module, so location.reload() after edits."}, {"id": "src_static_groundwork", "label": "src/static/groundwork.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_static_satellite", "label": "src/static/satellite.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_in_code_timers", "target": "src_static_groundwork", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_gpu_imagebitmap_dies", "target": "src_static_satellite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_gpu_imagebitmap_dies", "target": "src_static_groundwork", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-profiling-the-app-in-the-desktop-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_profiling_the_app_in_the_desktop_aditya_hidden_pane_visibility", "ta