{"nodes": [{"id": "docs_ux_audit_report", "label": "UX audit: first visit and conversion", "file_type": "document", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_ux_audit_intro", "label": "First-visit intro card", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A first-time visitor should watch a race replay and come back, so the intro shows the product before the chrome."}, {"id": "docs_ux_audit_view_switch", "label": "Three-way view switch", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two side-by-side segmented controls read as one confusing control, so they were merged into one three-way switch."}, {"id": "docs_ux_audit_replay_kind_tags", "label": "Replay kind tags in race picker", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pre-1996 races used to fail only after pressing play, so each race is tagged with what play gives."}, {"id": "docs_ux_audit_control_bar", "label": "Replay control bar menus", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The replay bar had 18 controls; menus cut it to 6 in replay and 4 in Simulate."}, {"id": "docs_ux_audit_tab_reorg", "label": "Seven-tab reorganization", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Strategy lab and the 3D replay are the features only this app has, so they lead the tabs; qualifying became a toggle in Results."}, {"id": "docs_ux_audit_gps_warm_up", "label": "Season GPS warm-up and lap-timing fallback", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An uncached GPS replay took up to a minute; the lap-timing replay now plays meanwhile and hands over to GPS mid-race."}, {"id": "docs_ux_audit_f1tv_connect_bar", "label": "F1 TV connect bar on Stream", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Playback needs the viewer's F1 TV account, so the failure moved from the player to a connect bar up front."}, {"id": "docs_ux_audit_return_notice", "label": "Return-visit notice and next-session countdown", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Returning visitors had no reason to come back; a notice for an unseen race and a countdown give one."}, {"id": "docs_ux_audit_lights_out_name", "label": "Rename to Lights Out", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The old name sounded like a developer tool and led with Formula 1's trademark; a trademark check is still pending."}, {"id": "docs_ux_audit_usage_events", "label": "Usage events and /api/counts", "file_type": "concept", "source_file": "docs/ux-audit.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing was measured; first-party event counts give a view of the changes with no third party involved."}, {"id": "docs_ux_audit_phone_tab_fade", "label": "Phone tab bar edge fade", "file_type": "con