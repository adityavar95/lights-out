{"nodes": [{"id": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_bookmarklet_signin", "label": "Bookmarklet reads login-session cookie", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Connect F1 TV the MultiViewer way: bookmarklet reads the login-session cookie on formula1.com and returns to the app hash. No server-side password or token storage, per the user's request."}, {"id": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_oauth_redirect_rejected", "label": "OAuth redirect back to app ruled out", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "The account site's PingOne client only redirects to formula1.com, so an OAuth code cannot come back to localhost."}, {"id": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_cookie_read_rejected", "label": "Reading F1 cookie from app page ruled out", "file_type": "rationale", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "Cross-site cookie read is impossible without an extension; MultiViewer is Electron and reads it from its own BrowserWindow."}, {"id": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_live_shared_token", "label": "Live feed shares one token across pollers", "file_type": "concept", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": "2026-10-26", "author": "ADITYA", "contributor": null, "rationale": "One shared live feed connection uses the last poller's token in memory, drops it when expired, and remembers a rejected token so pollers do not resend it every 5 s."}, {"id": "src_f1auth", "label": "src/f1auth.py", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_live", "label": "src/live.py", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "src_static_util", "label": "src/static/util.js", "file_type": "code", "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_bookmarklet_signin", "target": "src_f1auth", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_bookmarklet_signin", "target": "src_static_multiviewer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_bookmarklet_signin", "target": "src_static_app", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learnings/2026-10-26-f1-tv-sign-in-for-a-aditya.md", "source_location": null, "weight": 1.0}, {"source": "trail_learnings_2026_10_26_f1_tv_sign_in_for_a_aditya_bookmarklet_signin", "target": "src_static_util", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".trail/learn